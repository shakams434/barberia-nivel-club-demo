APP_NAME="Nivel Club"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://TU_DOMINIO
APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=USUARIO_CPANEL_BASE
DB_USERNAME=USUARIO_CPANEL_BASE
DB_PASSWORD=CONTRASENA_SEGURA_BASE

QUEUE_CONNECTION=database
CACHE_STORE=file
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

MAIL_MAILER=smtp
MAIL_HOST=SERVIDOR_SMTP
MAIL_PORT=465
MAIL_USERNAME=CORREO_DEL_NEGOCIO
MAIL_PASSWORD=CONTRASENA_DEL_CORREO
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=CORREO_DEL_NEGOCIO
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

WHATSAPP_PROVIDER=meta
WHATSAPP_SEND_ENABLED=false
WHATSAPP_TIMEOUT_SECONDS=5
WHATSAPP_MAX_ATTEMPTS=3
META_GRAPH_API_VERSION=v25.0
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

ALLOW_LOCAL_SAMPLE_DATA=false

VITE_APP_NAME="${APP_NAME}"
